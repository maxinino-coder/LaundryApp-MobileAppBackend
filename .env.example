# Copy to .env for local development. NEVER commit the real .env.
# In production these are set as environment variables on the host (Railway).

# ─── Database ────────────────────────────────────────────────
# Local:      jdbc:postgresql://localhost:5433/laundry_db
# Supabase:   jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5433/laundry_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=changeme

# ─── JWT ─────────────────────────────────────────────────────
# Must be at least 256 bits. Generate with: openssl rand -base64 48
JWT_SECRET=

# ─── Google OAuth ────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the backend redirects the browser back to after Google sign-in.
# Local: exp://127.0.0.1:8081   Production: laundrygo:// (the app's scheme)
FRONTEND_URL=laundrygo://

# ─── Server ──────────────────────────────────────────────────
# Public HTTPS origin of this backend. Used to build the Google sign-in URL.
# Local: http://localhost:8080   Production: https://<your-app>.up.railway.app
APP_PUBLIC_URL=http://localhost:8080
